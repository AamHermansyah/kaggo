API_BASE_URL=https://your-backend.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_TIMEOUT_MS=15000
SESSION_SECRET=generate-with-node--require("crypto").randomBytes(48).toString("base64url")

# Contact - from the client's About document
NEXT_PUBLIC_SUPPORT_EMAIL=support@mykaggo.com
NEXT_PUBLIC_SUPPORT_PHONE=+234 816 814 4560
# Full wa.me link. Leave blank until the client confirms it; "Contact Support"
# falls back to the support mailbox while it is empty.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Social profiles shown under "Connect with us". Blank ones are not rendered.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
