{
  "name": "kaggo-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:user-company": "pnpm --filter @kaggo/user-company dev",
    "dev:driver": "pnpm --filter @kaggo/driver dev",
    "dev:admin": "pnpm --filter @kaggo/admin dev",
    "build": "turbo build",
    "build:user-company": "turbo build --filter=@kaggo/user-company",
    "build:driver": "turbo build --filter=@kaggo/driver",
    "build:admin": "turbo build --filter=@kaggo/admin",
    "start:user-company": "pnpm --filter @kaggo/user-company start",
    "start:driver": "pnpm --filter @kaggo/driver start",
    "start:admin": "pnpm --filter @kaggo/admin start",
    "typecheck": "turbo typecheck",
    "typecheck:user-company": "pnpm --filter @kaggo/user-company typecheck",
    "typecheck:driver": "pnpm --filter @kaggo/driver typecheck",
    "typecheck:admin": "pnpm --filter @kaggo/admin typecheck",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "sw:check": "node scripts/sw-check.mjs",
    "shots": "node scripts/screenshots.mjs",
    "password:check": "node --experimental-strip-types scripts/password-check.mjs",
    "splash": "node scripts/splash.mjs",
    "phone:check": "node --experimental-strip-types scripts/phone-check.mjs"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.4.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
